{
  "name": "moder-viewer",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based viewer for .glb and .gltf 3D models. Nothing is uploaded.",
  "license": "MIT",
  "author": "zalaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zalaya/moder-viewer.git"
  },
  "homepage": "https://zalaya.github.io/moder-viewer/",
  "bugs": "https://github.com/zalaya/moder-viewer/issues",
  "keywords": [
    "three.js",
    "react-three-fiber",
    "gltf",
    "glb",
    "3d-viewer",
    "vite",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "development": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc",
    "check": "bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@animate-ui/react": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.60.0",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vite": "^8.3.4"
  }
}
